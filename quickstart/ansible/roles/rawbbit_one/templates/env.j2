COLLECTOR_PUBLIC_HOSTNAME={{ rawbbit_one_collector_hostname }}
S3_PUBLIC_HOSTNAME={{ rawbbit_one_s3_hostname }}
DOZZLE_PUBLIC_HOSTNAME={{ rawbbit_one_dozzle_hostname }}
LOG_LEVEL={{ rawbbit_one_log_level }}
NATS_URL=nats://nats:4222
NATS_STREAM=EVENTS
NATS_SUBJECT_PREFIX=events
NATS_STREAM_MAX_AGE_SECONDS={{ rawbbit_one_nats_stream_max_age_seconds }}
NATS_DUPLICATE_WINDOW_SECONDS=600
PORT=8080
MAX_EVENTS_PER_REQUEST=500
MAX_REQUEST_BYTES=1048576
COLLECTOR_API_KEYS_JSON={{ vault_rawbbit_one_collector_api_keys | to_json }}
IP_HASH_SALT={{ vault_rawbbit_one_ip_hash_salt | to_json }}
STORE_RAW_IP=0
GEOIP_ENABLED={{ rawbbit_one_geoip_enabled | ternary(1, 0) }}
GEOIP_MMDB_PATH=/var/lib/geoip/dbip-country-lite.mmdb
CORS_ALLOW_ORIGINS={{ rawbbit_one_cors_allow_origins }}
CORS_ALLOW_METHODS=POST,OPTIONS
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=0
CORS_MAX_AGE_SECONDS=600
NATS_CONSUMER=raw-writer
NATS_FETCH_BATCH=200
NATS_FETCH_TIMEOUT_SECONDS=1
NATS_ACK_WAIT_SECONDS=300
NATS_MAX_DELIVER=10
RAW_FLUSH_INTERVAL_SECONDS=60
RAW_MAX_EVENTS_PER_FILE=10000
RAW_MAX_BYTES_PER_FILE=52428800
RAW_STORAGE_BACKEND=s3
GCS_RAW_BUCKET=
GCS_RAW_PREFIX=raw
GOOGLE_APPLICATION_CREDENTIALS=
S3_ENDPOINT_URL=http://seaweed-s3:8333
S3_BUCKET={{ rawbbit_one_s3_bucket }}
S3_PREFIX={{ rawbbit_one_s3_prefix }}
S3_ACCESS_KEY={{ vault_rawbbit_one_s3_writer_access_key | to_json }}
S3_SECRET_KEY={{ vault_rawbbit_one_s3_writer_secret_key | to_json }}
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=1
S3_USE_SSL=0
S3_VERIFY_SSL=0
SEAWEED_VOLUME_SIZE_LIMIT_MB={{ rawbbit_one_seaweed_volume_size_limit_mb }}
SEAWEED_VOLUME_MAX={{ rawbbit_one_seaweed_volume_max }}
SEAWEED_VOLUME_MIN_FREE_SPACE_GB={{ rawbbit_one_seaweed_volume_min_free_space_gb }}
